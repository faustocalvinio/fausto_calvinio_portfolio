---
import '../styles/global.css';
import '../styles/font-tester.css';
import '../styles/cursor.css';
import Seo from '../components/Seo.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { seoConfig } from '../config/seo';
import type { SeoProps } from '../lib/seo';

interface Props extends SeoProps {}

const seoProps = Astro.props;
---

<!doctype html>
<html lang={seoConfig.site.language}>
  <head>
    <meta charset={seoConfig.head.charset} />
    <meta name="viewport" content={seoConfig.head.viewport} />
    <Seo {...seoProps} />
    <meta name="application-name" content={seoConfig.site.shortName} />
    <meta name="color-scheme" content={seoConfig.head.colorScheme} />
    <meta
      name="theme-color"
      content={seoConfig.head.themeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={seoConfig.head.themeColor.dark}
      media="(prefers-color-scheme: dark)"
    />
    {seoConfig.head.icons.map((icon) => <link {...icon} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Playfair+Display:opsz,wght@5..1200,400;5..1200,500;5..1200,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <ScrollToTop />
  </body>
</html>
