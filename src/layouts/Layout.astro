---
import '../styles/global.css';
import '../styles/font-tester.css';
import '../styles/cursor.css';
import Seo from '../components/Seo.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { siteConfig } from '../config/site';
import type { SeoProps } from '../lib/seo';

interface Props extends SeoProps {}

const seoProps = Astro.props;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Seo {...seoProps} />
    <meta name="application-name" content={siteConfig.shortName} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={siteConfig.seo.themeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={siteConfig.seo.themeColor.dark}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Playfair+Display:opsz,wght@5..1200,400;5..1200,500;5..1200,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <ScrollToTop />
  </body>
</html>
