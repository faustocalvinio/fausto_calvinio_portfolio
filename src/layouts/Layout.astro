---
import '../styles/global.css';
import '../styles/font-tester.css';
import ScrollToTop from '../components/ScrollToTop.astro';

const {
  title = 'Fausto Calviño — Software, IA y automatización',
  description = 'Ingeniero de software especializado en sistemas multiagente, agentes IA, automatización n8n e integraciones a medida.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#1f518f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Fraunces:opsz,wght,SOFT@9..144,360..700,0..100&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600&family=Playfair+Display:opsz,wght@5..1200,400;5..1200,500;5..1200,600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      const savedFont = localStorage.getItem('portfolio-font-pair');
      if (savedFont) document.documentElement.dataset.fontPair = savedFont;
    </script>
    <title>{title}</title>
  </head>
  <body><slot /><ScrollToTop /></body>
</html>
