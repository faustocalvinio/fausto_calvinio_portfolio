---
import { getCollection } from 'astro:content';
import NotesIndex from '../../../components/NotesIndex.astro';
import { siteConfig } from '../../../config/site';

const pageSize = siteConfig.content.notesPerPage;

export async function getStaticPaths() {
  const articleCount = (await getCollection('articles')).filter((article) => article.data.status !== 'draft').length;
  const totalPages = Math.ceil(articleCount / siteConfig.content.notesPerPage);
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({ params: { page: String(index + 2) } }));
}

const currentPage = Number(Astro.params.page);
const allArticles = (await getCollection('articles'))
  .filter((article) => article.data.status !== 'draft')
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const articles = allArticles.slice((currentPage - 1) * pageSize, currentPage * pageSize);
---

<NotesIndex articles={articles} currentPage={currentPage} totalPages={Math.ceil(allArticles.length / pageSize)} totalArticles={allArticles.length} />
