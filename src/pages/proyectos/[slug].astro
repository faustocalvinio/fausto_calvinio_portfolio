---
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import N8nWorkflowShowcase from '../../components/N8nWorkflowShowcase.astro';
import PythonCodeExplorer from '../../components/PythonCodeExplorer.astro';
import MultiAgentArchitectureCanvas from '../../components/MultiAgentArchitectureCanvas.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Layout from '../../layouts/Layout.astro';
import { seoConfig } from '../../config/seo';
import { siteConfig } from '../../config/site';
import { createBreadcrumbSchema, createProjectSchema, toAbsoluteUrl } from '../../lib/seo';

export async function getStaticPaths() {
  return (await getCollection('projects'))
    .filter((entry) => !entry.data.hidden)
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = '/proyectos/' + entry.data.slug + '/';
const externalUrls = Object.values(entry.data.links).filter((url): url is string => Boolean(url));
const structuredData = [
  createProjectSchema({
    title: entry.data.title, description: entry.data.summary, path,
    category: entry.data.category, stack: entry.data.stack, externalUrls,
  }),
  createBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Proyectos', url: '/#proyectos' },
    { name: entry.data.title, url: path },
  ]),
];
const isN8nProject = entry.data.slug === 'automatizaciones-n8n';
const isMultiAgentProject = entry.data.slug === 'plataforma-multi-rubro-agentes';
const hasWideVisual = isN8nProject || isMultiAgentProject || entry.data.visuals.some((visual) => visual.type === 'image' && visual.src);
const contactHref = 'mailto:' + seoConfig.author.email + '?subject=' + encodeURIComponent('Hablemos sobre ' + entry.data.title);
---

<Layout title={entry.data.title} description={entry.data.summary} pageSchemaType="ItemPage" mainEntityId={toAbsoluteUrl(path) + '#project'} structuredData={structuredData}>
  <Header />
  <main>
    <header class="detail-hero">
      <div class="container">
        <a class="back" href="/#proyectos">← Volver a proyectos</a>
        <p class="eyebrow">{entry.data.category} · {entry.data.year}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
        <ul class="tags">{entry.data.stack.map((technology) => <li>{technology}</li>)}</ul>
        <dl class="project-facts">
          <div><dt>Estado</dt><dd>{entry.data.status}</dd></div>
          {entry.data.role && <div><dt>Mi aporte</dt><dd>{entry.data.role}</dd></div>}
        </dl>
      </div>
    </header>

    <section class="section">
      <div class:list={['container', 'project-content', { 'detail-content-wide': hasWideVisual }]}>
        <div class="detail-copy">
          {entry.data.disclaimer && <p class="disclaimer">{entry.data.disclaimer}</p>}
          <h2>Problema</h2><p>{entry.data.problem}</p>
          <h2>Solución</h2><p>{entry.data.solution}</p>
        </div>

        <ProjectGallery visuals={entry.data.visuals} />

        {isN8nProject && <N8nWorkflowShowcase />}
        {isMultiAgentProject && (
          <section class="technical-evidence" aria-labelledby="architecture-title">
            <h2 id="architecture-title">Arquitectura del laboratorio</h2>
            <p>Organización de dominios y crews del MVP. Las cantidades describen su estructura, sin atribuir resultados de uso en producción.</p>
            <MultiAgentArchitectureCanvas />
            <h2>Extractos del código</h2>
            <PythonCodeExplorer />
          </section>
        )}

        <div class="detail-copy project-story">
          {entry.body?.trim() && <h2>Recorrido y decisiones</h2>}
          <Content />
          {externalUrls.length > 0 && (
            <div class="project-links">
              <h2>Explorar el proyecto</h2>
              {entry.data.links.live && <a class="case-link" href={entry.data.links.live} target="_blank" rel="noreferrer">Ver proyecto publicado ↗</a>}
              {entry.data.links.demo && <a class="case-link" href={entry.data.links.demo} target="_blank" rel="noreferrer">Explorar demo con datos de ejemplo ↗</a>}
              {entry.data.links.github && <a class="case-link" href={entry.data.links.github} target="_blank" rel="noreferrer">Ver código en GitHub ↗</a>}
            </div>
          )}
          <aside class="project-contact" aria-labelledby="project-contact-title">
            <p class="eyebrow">Sigamos la conversación</p>
            <h2 id="project-contact-title">¿Trabajamos en algo parecido?</h2>
            <p>Podemos hablar de tu producto, una integración o una oportunidad para sumarme a tu equipo.</p>
            <div class="project-contact-actions">
              <a class="btn btn-primary" href={contactHref}>Escribime sobre tu proyecto →</a>
              <a class="case-link" href={siteConfig.contact.cvPath} target="_blank" rel="noreferrer">Ver CV ↗</a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .project-facts { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 2rem; margin: 2rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .project-facts dt { color: var(--muted); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; margin-bottom: .5rem; }
  .project-facts dd { margin: 0; max-width: 62ch; color: var(--ink-soft); font-size: .95rem; }
  .project-content { min-width: 0; }
  .detail-copy { max-width: 72ch; margin-inline: auto; }
  .detail-copy h2 { margin-top: 2.5rem; }
  .detail-copy > h2:first-child { margin-top: 0; }
  .detail-copy :global(p), .detail-copy :global(li) { color: var(--ink-soft); }
  .detail-copy :global(h3) { margin-top: 2.3rem; font-size: 1.5rem; line-height: 1.25; }
  .detail-copy :global(li + li) { margin-top: .6rem; }
  .detail-copy :global(pre) { overflow-x: auto; padding: 1rem; background: var(--bg-alt); border: 1px solid var(--line); }
  .detail-copy .disclaimer { margin: 0 0 2rem; color: var(--accent-ink); }
  .technical-evidence { margin-block: 3rem; }
  .technical-evidence > h2 { margin: 2.5rem 0 1rem; }
  .technical-evidence > p { max-width: 65ch; color: var(--muted); }
  .project-story { margin-top: 3rem; }
  .project-links a { display: block; width: fit-content; margin-top: .8rem; }
  .project-contact { margin-top: 4rem; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--line-strong); background: var(--bg-alt); }
  .project-contact h2 { margin: 0 0 1rem; font-size: clamp(1.7rem, 1.4rem + 1vw, 2.3rem); }
  .project-contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  @media (max-width: 720px) { .project-facts { grid-template-columns: 1fr; gap: 1.2rem; } .project-contact-actions .btn { width: 100%; } }
</style>
