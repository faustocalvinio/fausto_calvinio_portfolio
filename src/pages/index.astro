---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroSystemVisual from '../components/HeroSystemVisual.astro';
import MultiAgentArchitectureCanvas from '../components/MultiAgentArchitectureCanvas.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import { homeConfig } from '../config/home';
import { siteConfig } from '../config/site';
import { seoConfig } from '../config/seo';
import Layout from '../layouts/Layout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => article.data.status !== 'draft')
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  .slice(0, siteConfig.content.homeNotesLimit);
const services = await getCollection('services');
const experience = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);
const marqueeItems = [
  ...homeConfig.technologyMarquee.items,
  ...homeConfig.technologyMarquee.items,
];
const emailHref = `mailto:${seoConfig.author.email}`;
const projectEmailHref = `${emailHref}?subject=${encodeURIComponent(
  siteConfig.contact.projectEmailSubject,
)}`;
---
<Layout type="profile" pageSchemaType="ProfilePage"><Header /><main>
<section class="hero section" id="inicio"><div class="container hero-layout"><div class="hero-copy"><p class="eyebrow">Ingeniería de software · IA aplicada</p><h1>Convierto procesos complejos en <span class="accent">sistemas de IA</span> que trabajan con tu equipo</h1><p class="hero-sub">Diseño agentes, automatizaciones e integraciones que conectan herramientas, reducen trabajo manual y dejan operaciones más claras, medibles y preparadas para crecer.</p><p class="status">{siteConfig.contact.availability}</p><div class="hero-actions"><a class="btn btn-primary" href={projectEmailHref}>Escribime por email</a><a class="btn btn-ghost" href="#proyectos">Ver proyectos</a></div></div><div class="hero-visual-wrap"><HeroSystemVisual {...homeConfig.heroSystemVisual} /></div></div></section>
<section class="section section-alt" id="servicios"><div class="container"><div class="section-head"><p class="eyebrow">Qué puedo construir</p><h2>Automatización con criterio de ingeniería</h2><p class="lede">Trabajo desde el problema operativo hasta el sistema en producción: agentes, workflows, APIs, interfaces y documentación.</p></div><div class="cards">{services.map(s=><article class="card"><h3>{s.data.title}</h3><p><strong>{s.data.shortDescription}</strong></p><p>{s.data.description}</p><ul class="tags">{s.data.technologies.map(t=><li>{t}</li>)}</ul></article>)}</div></div></section>
<section class="section" id="plataforma"><div class="container"><div class="feature feature-stacked" style="grid-template-columns:1fr"><div style="max-width:68ch"><p class="eyebrow">Caso principal</p><h3>Plataforma Multi-Rubro de Agentes IA</h3><p>Una arquitectura de 55 crews y aproximadamente 270 agentes para explorar problemas de ocho dominios con workflows especializados.</p><a class="case-link" href="/proyectos/plataforma-multi-rubro-agentes/">Explorar la arquitectura →</a></div><div><div class="stat-grid"><div class="stat"><strong>55</strong><span>crews</span></div><div class="stat"><strong>~270</strong><span>agentes</span></div><div class="stat"><strong>8</strong><span>dominios</span></div></div><MultiAgentArchitectureCanvas /></div></div></div></section>
<section class="marquee-section" aria-label={homeConfig.technologyMarquee.label}><div class="marquee-track" style={`animation-duration:${homeConfig.technologyMarquee.durationSeconds}s`}>{marqueeItems.map(item=><span class="marquee-item">{item}</span>)}</div></section>
<SelectedWorks />
<section class="section" id="enfoque"><div class="container manifesto-grid"><div class="manifesto-head"><p class="eyebrow">Enfoque</p><h2>Me involucro, pregunto y construyo con criterio</h2></div><ol class="manifesto-list"><li>Me gusta entender el problema de fondo antes de pensar en una solución.</li><li>Trabajo con curiosidad y aprendo lo necesario para avanzar.</li><li>Busco comunicar mis decisiones de forma clara durante todo el proceso.</li><li>Cuido tanto la experiencia de quien usa el sistema como la de quien debe mantenerlo.</li><li>Prefiero construir soluciones simples, útiles y preparadas para evolucionar.</li></ol></div></section>
<section class="section section-alt" id="sobre-mi"><div class="container about-grid"><div class="about-copy"><p class="eyebrow">Sobre mí</p><h2>Software, sistemas y aprendizaje continuo</h2><p class="lede">Desde mediados de 2021 me formo como Software Engineer de manera autodidacta. Mi base está en React, Next.js, Node.js y bases de datos; hoy la extiendo hacia Python, CrewAI, n8n y la construcción de sistemas inteligentes.</p><p class="lede">Empecé construyendo productos web, sitios autogestionables y e-commerce. Esa experiencia me enseñó que una solución útil no se mide solo por la tecnología: tiene que ser clara para quien la usa, sostenible para quien la mantiene y conectarse con el trabajo real del equipo.</p><p class="lede">Hoy me interesa diseñar sistemas que reduzcan trabajo manual y conviertan procesos dispersos en flujos claros: desde una integración puntual hasta una arquitectura de agentes con responsabilidades, límites y resultados medibles.</p><div class="about-actions"><a class="btn btn-ghost" href="#proyectos">Ver proyectos seleccionados</a><a class="case-link" href={emailHref}>Hablemos de tu proceso →</a></div></div><aside class="about-sidebar"><p class="eyebrow">Recorrido</p><div class="about-timeline">{experience.map(item=><article class="about-item"><h3>{item.data.title}</h3><p>{item.data.description}</p>{item.data.link&&<a class="case-link" href={item.data.link}>Ver más →</a>}</article>)}</div></aside></div></section>
<section class="section" id="notas"><div class="container"><div class="section-head"><p class="eyebrow">Notas</p><h2>Aprendizajes en público</h2></div><div class="article-list">{articles.map(a=><a class="article-row" href={a.data.externalUrl??`/notas/${a.data.slug}/`} target={a.data.externalUrl?'_blank':undefined} rel={a.data.externalUrl?'noreferrer':undefined}><span class="article-date">{a.data.publishedAt}</span><h3>{a.data.title}</h3><span class="case-link">{a.data.externalUrl?'↗':'→'}</span></a>)}</div><div class="article-list-action"><a class="btn btn-ghost" href="/notas/">Ver todas las notas →</a></div></div></section>
<section class="section contact-section" id="contacto"><div class="container"><div class="contact-showcase"><div class="contact-copy"><p class="eyebrow">Contacto</p><h2>¿Qué proceso te gustaría mejorar?</h2><p class="lede">Contame qué parte de tu operación es repetitiva, lenta o difícil de conectar. Podemos pensar una primera arquitectura, definir el alcance y convertirlo en un sistema que realmente ayude a tu equipo.</p><div class="contact-actions"><a class="btn btn-primary" href={projectEmailHref}>Empecemos por email <span aria-hidden="true">→</span></a><a class="btn btn-ghost" href={siteConfig.contact.cvPath} target="_blank" rel="noreferrer">Ver CV</a></div></div><div class="contact-links contact-network"><a class="contact-link" href={emailHref}><small>Escribime</small><span>{seoConfig.author.email}</span><b aria-hidden="true">↗</b></a><a class="contact-link" href={seoConfig.social.linkedin.url} target="_blank" rel="me noreferrer"><small>Conectemos</small><span>{seoConfig.social.linkedin.label}</span><b aria-hidden="true">↗</b></a><a class="contact-link" href={seoConfig.social.github.url} target="_blank" rel="me noreferrer"><small>Explorá el código</small><span>{seoConfig.social.github.label}</span><b aria-hidden="true">↗</b></a><a class="contact-link" href={seoConfig.social.telegram.url} target="_blank" rel="me noreferrer"><small>Mensaje directo</small><span>Telegram · @faustocalvinio</span><b aria-hidden="true">↗</b></a></div></div></div></section>
</main><Footer />
<style>
  .hero{--hero-star:color-mix(in srgb,var(--accent) 46%,transparent);--spectrum-a:color-mix(in srgb,#3d8fd1 24%,transparent);--spectrum-b:color-mix(in srgb,#7367c9 18%,transparent);position:relative;isolation:isolate;overflow:hidden;padding-top:clamp(3rem,5vw,4rem);padding-bottom:clamp(4rem,7vw,5.75rem)}
  .hero:before{position:absolute;z-index:-2;top:-18rem;right:-13rem;width:54rem;height:46rem;border-radius:50%;background:conic-gradient(from 215deg,transparent 0 20%,var(--spectrum-a) 36%,var(--spectrum-b) 49%,transparent 68%);filter:blur(54px);content:'';opacity:.62;pointer-events:none;transform:rotate(-8deg);animation:hero-spectrum 12s ease-in-out infinite}
  .hero:after{position:absolute;z-index:-1;inset:0;background-image:radial-gradient(circle,var(--hero-star) 1px,transparent 1.4px),radial-gradient(circle,color-mix(in srgb,var(--ink) 24%,transparent) .8px,transparent 1.2px);background-position:8px 11px,31px 22px;background-size:53px 53px,89px 89px;content:'';opacity:.42;pointer-events:none;mask-image:linear-gradient(90deg,transparent 2%,rgba(0,0,0,.28) 30%,#000 68%,rgba(0,0,0,.72) 100%)}
  .hero-layout{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:clamp(2.75rem,5vw,4rem)}
  .hero-copy{min-width:0;max-width:none}
  .hero-copy .eyebrow{max-width:36rem}
  .hero-copy h1{max-width:none;width:100%;margin:0 0 1.4rem;font-size:clamp(2.7rem,1.7rem + 2.2vw,4.15rem)}
  .hero-copy .hero-sub{max-width:57ch;margin-bottom:1.25rem}
  .hero-copy .hero-actions{margin-top:1.8rem}
  .hero-visual-wrap{width:100%;min-width:0}
  @media(max-width:560px){.hero{padding-top:clamp(3.5rem,12vw,5rem)}.hero-copy h1{font-size:clamp(2.45rem,12vw,3.75rem)}.hero-layout{gap:2.75rem}.hero-actions{display:grid}.hero-actions .btn{width:100%}}
  @keyframes hero-spectrum{0%,100%{opacity:.48;transform:rotate(-8deg) scale(.96)}50%{opacity:.72;transform:rotate(-3deg) scale(1.06)}}
  @media(prefers-color-scheme:dark){.hero{--hero-star:color-mix(in srgb,var(--accent) 56%,transparent);--spectrum-a:color-mix(in srgb,#2d7fbf 28%,transparent);--spectrum-b:color-mix(in srgb,#735ad0 22%,transparent)}}
  @media(prefers-reduced-motion:reduce){.hero-visual-wrap{transform:none}.hero:before{animation:none}}
</style>
</Layout>
