      border-color: var(--accent);
      background: var(--accent);
      color: #fff;
    }

    .desk-button:disabled {
      cursor: not-allowed;
      opacity: .45;
    }

    @media (max-width: 1080px) {
      .metadata-grid {
        grid-template-columns: 1fr 1fr;
