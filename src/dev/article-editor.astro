    .markdown-toolbar button {
      min-width: 38px;
      height: 34px;
      padding: 0 .6rem;
      border: 0;
      background: var(--bg);
      color: var(--ink-soft);
      cursor: pointer;
      font-size: .75rem;
    }

    .markdown-toolbar button:hover {
      background: var(--accent-tint);
      color: var(--accent-ink);
    }

    #body {
      min-height: 580px;
      padding: 1.25rem;
      border: 0;
      border-radius: 0;
      outline: 0;
      resize: none;
      background: var(--bg);
      font: .92rem/1.7 ui-monospace, SFMono-Regular, Consolas, monospace;
      tab-size: 2;
    }

    #body:focus {
      box-shadow: inset 3px 0 0 var(--accent);
    }

    .output-pane {
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .output-tabs {
      justify-content: flex-start;
      gap: 0;
      padding: 0 .8rem;
    }

    .output-tabs > button {
      align-self: stretch;
      padding: 0 .8rem;
      border: 0;
      border-bottom: 2px solid transparent;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: .74rem;
    }

    .output-tabs > button[aria-selected='true'] {
      border-bottom-color: var(--accent);
      color: var(--ink);
    }

    .output-tabs .copy-button {
      margin-left: auto;
      color: var(--accent-ink);
    }

