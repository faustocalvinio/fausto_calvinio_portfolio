      color: var(--muted);
      font-size: .68rem;
    }

    .markdown-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 1px;
      padding: .5rem;
      border-bottom: 1px solid var(--line);
      background: var(--line);
