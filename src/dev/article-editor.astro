      #generated-markdown {
        min-height: 620px;
      }
    }

    @media (max-width: 760px) {
      .editor-header-inner {
        grid-template-columns: 1fr auto;
      }

      .development-label {
        display: none;
      }

      .editor-intro,
      .draft-strip {
        grid-template-columns: 1fr;
      }

      .editor-intro {
        gap: 1.25rem;
      }

      .editor-intro h1 {
        font-size: clamp(2.5rem, 13vw, 4.2rem);
      }

      .draft-strip {
