        flex-direction: column;
      }

      .draft-actions {
        display: grid;
      }

      .metadata-grid {
        grid-template-columns: 1fr;
      }

      .metadata-grid .field {
        grid-column: 1;
      }

      .pane-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: .2rem;
      }

      .save-bar {
