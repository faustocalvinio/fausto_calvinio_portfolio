    #file-panel {
      position: relative;
      min-height: 0;
      overflow: hidden;
    }

    #preview-panel[hidden],
    #file-panel[hidden] {
      display: none;
    }

    #preview-frame {
      width: 100%;
      height: 100%;
      min-height: 626px;
      display: block;
      border: 0;
      background: var(--bg);
    }

    .preview-state {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      padding: 2rem;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      color: var(--muted);
      text-align: center;
      font-size: .8rem;
    }

    .preview-state[hidden] {
      display: none;
    }

    #generated-markdown {
      height: 100%;
      min-height: 626px;
      margin: 0;
      padding: 1.25rem;
      overflow: auto;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      background: var(--bg-alt);
      color: var(--ink-soft);
      font: .82rem/1.65 ui-monospace, SFMono-Regular, Consolas, monospace;
    }

    .save-bar {
      position: sticky;
      bottom: 0;
      z-index: 20;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      min-height: 76px;
      padding: .9rem clamp(1.25rem, 3.5vw, 3rem);
      border-top: 1px solid var(--line-strong);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(14px);
    }

    .save-feedback {
      max-width: 65ch;
      color: var(--muted);
      font-size: .78rem;
    }

    .save-feedback[data-tone='pending'] {
      color: var(--accent-ink);
    }

    .save-feedback[data-tone='success'] {
      color: #23754a;
    }

    .save-feedback[data-tone='error'] {
      color: #b54b4b;
    }

    @media (prefers-color-scheme: dark) {
      .save-feedback[data-tone='success'] {
        color: #72c89a;
      }

      .save-feedback[data-tone='error'] {
        color: #e88888;
      }
    }

    .save-actions {
      display: flex;
      gap: .6rem;
      flex: 0 0 auto;
    }

    .desk-button {
      min-height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .4rem;
      padding: .65rem 1rem;
      border: 1px solid var(--line-strong);
      border-radius: 2px;
      text-decoration: none;
      cursor: pointer;
      font: 500 .82rem var(--font-sans);
    }

