    }

    .desk-button-quiet {
      background: var(--bg);
      color: var(--ink);
    }

    .desk-button-quiet:hover {
      border-color: var(--ink);
    }

    .desk-button-primary {
      min-width: 138px;
      border-color: var(--ink);
      background: var(--ink);
      color: var(--on-ink);
    }

