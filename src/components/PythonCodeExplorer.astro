<script>
  const codeTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-code-tab]'));
  const fileTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-file-trigger]'));
  const codePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-code-panel]'));
  const breadcrumbFolder = document.querySelector<HTMLElement>('[data-code-folder]');
  const breadcrumbName = document.querySelector<HTMLElement>('[data-code-name]');

  function activateFile(id: string) {
    codeTabs.forEach((tab) => {
      const active = tab.dataset.codeTab === id;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    fileTriggers.forEach(trigger => trigger.classList.toggle('active', trigger.dataset.fileTrigger === id));
    codePanels.forEach((panel) => {
      const active = panel.dataset.codePanel === id;
      panel.hidden = !active;
      panel.classList.toggle('active', active);
      if (active) {
        if (breadcrumbFolder) breadcrumbFolder.textContent = panel.dataset.folder || 'orquestacion';
        if (breadcrumbName) breadcrumbName.textContent = panel.dataset.name || '';
      }
    });
  }

  codeTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateFile(tab.dataset.codeTab!));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const next = codeTabs[(index + direction + codeTabs.length) % codeTabs.length];
      activateFile(next.dataset.codeTab!);
      next.focus();
    });
  });
  fileTriggers.forEach(trigger => trigger.addEventListener('click', () => activateFile(trigger.dataset.fileTrigger!)));
</script>

