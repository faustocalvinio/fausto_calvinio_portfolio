---
const workflows = [
  {
    id: 'leads',
    number: '01',
    title: 'Lead entrante → oportunidad comercial',
    eyebrow: 'Ventas · CRM',
    description: 'Captura, enriquece y prioriza cada consulta antes de que llegue al equipo comercial.',
    outcome: 'El vendedor recibe el contacto, su contexto y el próximo paso en el CRM.',
    nodes: [
      { icon: '↗', name: 'Webhook', detail: 'Formulario web', tone: 'coral' },
      { icon: '{}', name: 'Normalizar', detail: 'Email · empresa', tone: 'blue' },
      { icon: '◇', name: 'Enriquecer', detail: 'Datos públicos', tone: 'violet' },
      { icon: 'IF', name: 'Scoring', detail: 'Perfil + intención', tone: 'amber' },
      { icon: '◎', name: 'HubSpot', detail: 'Crear contacto', tone: 'orange' },
      { icon: '#', name: 'Slack', detail: 'Avisar al owner', tone: 'green' },
    ],
    steps: ['Respuesta inmediata', 'Deduplicación por email', 'Asignación por territorio'],
  },
  {
    id: 'facturas',
    number: '02',
    title: 'Factura recibida → aprobación y registro',
    eyebrow: 'Finanzas · Backoffice',
    description: 'Lee adjuntos, extrae datos y deriva sólo las excepciones para revisión humana.',
    outcome: 'La factura válida queda registrada; los casos dudosos esperan aprobación con todo el contexto.',
    nodes: [
      { icon: 'M', name: 'Gmail', detail: 'Nuevo adjunto', tone: 'coral' },
      { icon: 'PDF', name: 'Extraer', detail: 'OCR + campos', tone: 'blue' },
      { icon: '≠', name: 'Validar', detail: 'CUIT · totales', tone: 'violet' },
      { icon: 'IF', name: '¿Coincide?', detail: 'Orden de compra', tone: 'amber' },
      { icon: '✓', name: 'Aprobar', detail: 'Revisión humana', tone: 'green' },
      { icon: '▦', name: 'ERP / Sheet', detail: 'Registrar pago', tone: 'orange' },
    ],
    steps: ['Control de duplicados', 'Trazabilidad del archivo', 'Ruta de excepción'],
  },
  {
    id: 'soporte',
    number: '03',
    title: 'Consulta de cliente → respuesta con contexto',
    eyebrow: 'Soporte · RAG',
    description: 'Clasifica el mensaje, busca conocimiento autorizado y decide si responder o escalar.',
    outcome: 'Las consultas conocidas se resuelven rápido; las sensibles llegan a una persona con el historial completo.',
    nodes: [
      { icon: 'W', name: 'WhatsApp', detail: 'Mensaje entrante', tone: 'green' },
      { icon: 'AI', name: 'Clasificar', detail: 'Tema + urgencia', tone: 'violet' },
      { icon: '⌕', name: 'Buscar', detail: 'Base vectorial', tone: 'blue' },
      { icon: 'IF', name: 'Confianza', detail: 'Umbral seguro', tone: 'amber' },
      { icon: '↳', name: 'Responder', detail: 'Cita la fuente', tone: 'coral' },
      { icon: 'H', name: 'Escalar', detail: 'Agente humano', tone: 'orange' },
    ],
    steps: ['Memoria por conversación', 'Fuentes restringidas', 'Escalamiento por riesgo'],
  },
];
---

<section class="workflow-showcase" aria-labelledby="workflow-title">
  <div class="workflow-intro">
    <div>
      <p class="workflow-kicker">Automatizaciones en acción</p>
      <h2 id="workflow-title">Un proceso completo, no sólo nodos conectados</h2>
    </div>
    <p>Cada flujo combina disparadores, reglas de negocio, integraciones y puntos de control. Elegí un caso para ver cómo viaja la información.</p>
  </div>

  <div class="workflow-tabs" role="tablist" aria-label="Casos de uso">
    {workflows.map((workflow, index) => (
      <button class:list={['workflow-tab', { active: index === 0 }]} type="button" role="tab" tabindex={index === 0 ? 0 : -1} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`workflow-${workflow.id}`} id={`tab-${workflow.id}`} data-workflow-tab={workflow.id}>
        <span>{workflow.number}</span>{workflow.eyebrow}
      </button>
    ))}
  </div>

  <div class="workflow-stage">
    <div class="stage-toolbar" aria-hidden="true">
      <div class="stage-brand"><span class="n8n-mark">n8n</span><span>Production workflow</span></div>
      <div class="execution-state"><i></i> Ejecución completada</div>
    </div>

    {workflows.map((workflow, index) => (
      <article class:list={['workflow-panel', { active: index === 0 }]} id={`workflow-${workflow.id}`} role="tabpanel" aria-labelledby={`tab-${workflow.id}`} hidden={index !== 0} data-workflow-panel={workflow.id}>
        <div class="panel-heading">
          <div><p>{workflow.eyebrow}</p><h3>{workflow.title}</h3></div>
          <p class="panel-description">{workflow.description}</p>
        </div>

        <div class="workflow-canvas" aria-label={`Diagrama: ${workflow.title}`}>
          <div class="canvas-grid">
            {workflow.nodes.map((node, nodeIndex) => (
              <>
                <div class="workflow-node" style={`--node-delay:${nodeIndex * 0.42}s`}>
                  <span class={`node-icon ${node.tone}`}>{node.icon}</span>
                  <span class="node-copy"><strong>{node.name}</strong><small>{node.detail}</small></span>
                  <span class="node-check" aria-label="Ejecutado">✓</span>
                  <i class="node-port in"></i><i class="node-port out"></i>
                </div>
                {nodeIndex < workflow.nodes.length - 1 && <div class="workflow-connection" aria-hidden="true" style={`--pulse-delay:${nodeIndex * 0.42}s`}><span></span></div>}
              </>
            ))}
          </div>
        </div>

        <div class="workflow-result">
          <div><span>Resultado operativo</span><strong>{workflow.outcome}</strong></div>
          <ul>{workflow.steps.map(step => <li>{step}</li>)}</ul>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-workflow-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-workflow-panel]'));
  function activateWorkflow(id: string) {
    tabs.forEach((tab) => {
      const active = tab.dataset.workflowTab === id;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => {
      const active = panel.dataset.workflowPanel === id;
      panel.hidden = !active;
      panel.classList.toggle('active', active);
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateWorkflow(tab.dataset.workflowTab!));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      activateWorkflow(next.dataset.workflowTab!);
      next.focus();
    });
  });
</script>

<style>
  .workflow-showcase{margin:0 0 clamp(4rem,9vw,7rem)}
  .workflow-intro{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(2rem,6vw,5rem);align-items:end;margin-bottom:2rem}
  .workflow-kicker{margin:0 0 .65rem;color:#ff6d5a;font-size:.75rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  .workflow-intro h2{max-width:15ch;margin:0;font-size:clamp(2rem,4vw,3.4rem)}
  .workflow-intro>p{margin:0;color:var(--muted)}
  .workflow-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-bottom:0;border-radius:14px 14px 0 0;overflow:hidden}
  .workflow-tab{display:flex;align-items:center;gap:.65rem;min-height:58px;padding:.85rem 1rem;border:0;background:var(--bg-alt);color:var(--muted);cursor:pointer;text-align:left;font-size:.82rem;transition:background .2s,color .2s}
  .workflow-tab span{display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--line-strong);border-radius:7px;font-size:.7rem;font-weight:700}
  .workflow-tab:hover,.workflow-tab.active{color:var(--ink);background:var(--bg)}
  .workflow-tab.active span{border-color:#ff6d5a;background:#ff6d5a;color:#fff}
  .workflow-stage{overflow:hidden;border:1px solid var(--line);border-radius:0 0 14px 14px;background:color-mix(in srgb,var(--bg-alt) 60%,var(--bg))}
  .stage-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.75rem 1rem;border-bottom:1px solid var(--line);background:var(--bg);font-size:.72rem;color:var(--muted)}
  .stage-brand,.execution-state{display:flex;align-items:center;gap:.65rem}.n8n-mark{color:#ff6d5a;font-weight:800;letter-spacing:-.06em;font-size:1rem}
  .execution-state i{width:7px;height:7px;border-radius:50%;background:#4cac77;box-shadow:0 0 0 4px color-mix(in srgb,#4cac77 14%,transparent)}
  .workflow-panel{padding:clamp(1.2rem,3vw,2rem)}.workflow-panel.active{animation:panel-in .35s ease both}
  .panel-heading{display:grid;grid-template-columns:1.2fr .8fr;gap:2rem;align-items:end;margin-bottom:1.3rem}
  .panel-heading p{margin:0;color:var(--muted)}.panel-heading>div>p{font-size:.68rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .panel-heading h3{margin:.25rem 0 0;font-size:clamp(1.35rem,2.2vw,1.9rem)}.panel-description{font-size:.9rem}
  .workflow-canvas{--canvas-bg:#eef2f7;--canvas-dot:#c1cad6;--node-bg:#fff;--node-border:#aeb9c8;--node-text:#182433;--node-muted:#617286;--connection:#8795a8;overflow-x:auto;padding:clamp(2.4rem,6vw,4.5rem) clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:10px;background-color:var(--canvas-bg);background-image:radial-gradient(circle,var(--canvas-dot) 1px,transparent 1.2px);background-size:20px 20px;box-shadow:inset 0 16px 40px rgba(46,63,82,.08);color-scheme:light}
  .canvas-grid{display:grid;grid-template-columns:repeat(11,max-content);align-items:center;justify-content:center;min-width:920px}
  .workflow-node{position:relative;display:flex;align-items:center;gap:.6rem;width:128px;min-height:64px;padding:.7rem;border:1px solid var(--node-border);border-radius:7px;background:var(--node-bg);color:var(--node-text);box-shadow:0 9px 24px rgba(46,63,82,.14);animation:node-run 3.2s ease-in-out var(--node-delay) infinite}
  .node-icon{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:6px;color:#fff;font-size:.66rem;font-weight:800}
  .node-icon.coral{background:#dc5f51}.node-icon.blue{background:#3c78b8}.node-icon.violet{background:#765bb2}.node-icon.amber{background:#bd8427}.node-icon.orange{background:#cf6f3e}.node-icon.green{background:#3f9468}
  .node-copy{min-width:0;display:grid;line-height:1.25}.node-copy strong,.node-copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .node-copy strong{font-size:.72rem}.node-copy small{color:var(--node-muted);font-size:.58rem}
  .node-check{position:absolute;right:-5px;top:-6px;display:grid;place-items:center;width:16px;height:16px;border:2px solid var(--node-bg);border-radius:50%;background:#4cac77;color:#fff;font-size:.55rem;opacity:.55;animation:check-run 3.2s ease var(--node-delay) infinite}
  .node-port{position:absolute;top:50%;width:8px;height:8px;border:2px solid var(--connection);border-radius:50%;background:var(--node-bg);transform:translateY(-50%)}.node-port.in{left:-5px}.node-port.out{right:-5px}
  .workflow-connection{position:relative;width:34px;height:2px;background:var(--connection)}.workflow-connection:after{content:'';position:absolute;right:-1px;top:-3px;width:6px;height:6px;border-top:2px solid var(--connection);border-right:2px solid var(--connection);transform:rotate(45deg)}
  .workflow-connection span{position:absolute;top:-2px;left:0;width:6px;height:6px;border-radius:50%;background:#ff6d5a;box-shadow:0 0 8px #ff6d5a;animation:pulse-through 3.2s linear var(--pulse-delay) infinite}
  .workflow-result{display:grid;grid-template-columns:1.15fr .85fr;gap:2rem;margin-top:1rem;padding:1.1rem 1.2rem;border:1px solid var(--line);border-radius:9px;background:var(--bg)}
  .workflow-result>div{display:grid;gap:.25rem}.workflow-result span{color:var(--muted);font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.workflow-result strong{font-size:.9rem;line-height:1.45}
  .workflow-result ul{display:flex;flex-wrap:wrap;align-content:center;gap:.4rem;margin:0;padding:0;list-style:none}.workflow-result li{padding:.3rem .55rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.66rem}
  @keyframes pulse-through{0%,12%{transform:translateX(0);opacity:0}20%{opacity:1}42%{transform:translateX(30px);opacity:1}48%,100%{transform:translateX(30px);opacity:0}}
  @keyframes node-run{0%,15%,55%,100%{border-color:var(--node-border)}30%,42%{border-color:#4cac77;box-shadow:0 0 0 2px rgba(76,172,119,.18),0 9px 24px rgba(0,0,0,.2)}}
  @keyframes check-run{0%,18%,55%,100%{opacity:.35;transform:scale(.8)}30%,42%{opacity:1;transform:scale(1)}}@keyframes panel-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  @media(max-width:800px){.workflow-intro,.panel-heading,.workflow-result{grid-template-columns:1fr;gap:1rem}.workflow-tabs{grid-template-columns:1fr}.workflow-tab{min-height:50px}.workflow-canvas{margin-inline:calc(clamp(1.2rem,3vw,2rem) * -1);border-inline:0;border-radius:0}}
  @media(prefers-color-scheme:dark){.workflow-canvas{--canvas-bg:#10151d;--canvas-dot:#3b4553;--node-bg:#202731;--node-border:#3d4857;--node-text:#edf2f7;--node-muted:#9aa8b8;--connection:#526071;box-shadow:inset 0 16px 40px rgba(0,0,0,.18);color-scheme:dark}}
  @media(prefers-reduced-motion:reduce){.workflow-panel.active,.workflow-node,.node-check,.workflow-connection span{animation:none}.workflow-connection span{display:none}}
</style>

<style is:global>
  .detail-content.detail-content-wide{max-width:var(--maxw)}
  .detail-content-wide .detail-copy{max-width:72ch}
</style>
