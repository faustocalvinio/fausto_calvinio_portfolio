---
import Icon from './PreviewIcon.astro';
interface Props { idPrefix: string; }
const { idPrefix } = Astro.props;
const contacts = [
  {
    initials: 'JL',
    name: 'Julián López',
    text: '¿Me armás un presupuesto por 12?',
    time: '14:32',
    status: 'Pendiente',
  },
  {
    initials: 'LM',
    name: 'Lucía Martínez',
    text: '¡Gracias por el catálogo!',
    time: '14:18',
    status: 'Cerrada',
  },
  {
    initials: 'TG',
    name: 'Tomás García',
    text: 'Perfecto, paso mañana.',
    time: '13:56',
    status: 'Cerrada',
  },
  {
    initials: 'CD',
    name: 'Carolina Díaz',
    text: 'Pedido confirmado. ¡Gracias!',
    time: '12:40',
    status: 'Cerrada',
  },
];
const stages = [
  {
    title: 'Nuevo lead',
    names: ['Lucía Martínez', 'Tomás García'],
    text: 'Consulta por catálogo',
  },
  {
    title: 'Presupuesto',
    names: ['Julián López'],
    text: '12 sillas Nórdica · color negro',
  },
  {
    title: 'Venta concretada',
    names: ['Carolina Díaz'],
    text: 'Pedido confirmado',
  },
];
---

<section
  id={idPrefix + "-en-vivo"}
  class="crm-preview" data-crm-preview
  aria-label="Vista previa de Hanexa CRM"
>
  <div class="preview-intro">
    <div>
      <h4>Así se ve en el panel</h4>
      <p>
        La conversación, el seguimiento y la información del cliente, en el
        mismo lugar.
      </p>
    </div>
    <span>VISTA PREVIA · DATOS FICTICIOS</span>
  </div>
  <div class="crm-shell">
    <aside class="crm-sidebar" aria-label="Menú del panel de ejemplo">
      <span class="crm-wordmark">hanexa</span>
      <div class="crm-business">
        <b class="crm-avatar">CN</b>
        <div>
          <strong>Casa Nórdica</strong>
          <small>Tu espacio de trabajo</small>
        </div>
      </div>
      <div class="crm-menu-item">
        <Icon name="store" size={16} /> Inicio
      </div>
      <div
        class="crm-tabs"
        role="tablist"
        aria-label="Vistas del CRM"
        aria-orientation="vertical"
      >
        <button
          id={idPrefix + "-inbox-tab"}
          role="tab"
          aria-selected="true"
          aria-controls={idPrefix + "-inbox-panel"}
          data-product-tab="inbox"
        >
          <Icon name="chat" size={16} /> Bandeja
        </button>
        <button
          id={idPrefix + "-pipeline-tab"}
          role="tab"
          aria-selected="false"
          aria-controls={idPrefix + "-pipeline-panel"}
          tabindex="-1"
          data-product-tab="pipeline"
        >
          <Icon name="workflow" size={16} /> Pipeline
        </button>
      </div>
      <div class="crm-menu-item">
        <Icon name="people" size={16} /> Contactos
      </div>
      <small class="crm-menu-label">ATENCIÓN</small>
      <div class="crm-menu-item">
        <Icon name="bolt" size={16} /> Respuestas rápidas
      </div>
      <div class="crm-menu-item">
        <Icon name="clock" size={16} /> Seguimiento
      </div>
      <small class="crm-menu-label">BOT</small>
      <div class="crm-menu-item">
        <Icon name="atom" size={16} /> Agentes de IA
      </div>
      <div class="crm-menu-item">
        <Icon name="flask" size={16} /> Probar bot
      </div>
      <div class="crm-menu-item">
        <Icon name="book" size={16} /> Catálogo y stock
      </div>
      <div class="crm-user">
        <b class="crm-avatar">VA</b>
        <div>
          <strong>Valentina Acosta</strong>
          <small>Administradora</small>
        </div>
      </div>
    </aside>
    <div class="crm-workspace">
      <div class="crm-topbar">
        <div>
          <small>CASA NÓRDICA</small>
          <strong>Tu espacio de atención</strong>
        </div>
        <span class="crm-support">Soporte Hanexa</span>
      </div>
      <div
        id={idPrefix + "-inbox-panel"}
        role="tabpanel"
        aria-labelledby={idPrefix + "-inbox-tab"}
        class="crm-inbox"
      >
        <aside class="crm-conversations" aria-label="Conversaciones de ejemplo">
          <div class="crm-automation">
            <i></i> Automatizando en 1 canal
          </div>
          <div class="crm-list-heading">
            <strong>Bandeja de entrada</strong>
            <span>4</span>
          </div>
          <div class="crm-filters">
            <span>Todos</span>
            <span>Etapas ⌄</span>
            <span>Etiquetas ⌄</span>
          </div>
          {contacts.map((contact, index) => (
            <div class:list={['crm-conversation', { selected: index === 0 }]}>
              <b class="crm-avatar">{contact.initials}</b>
              <div>
                <div class="crm-contact-line">
                  <strong>{contact.name}</strong>
                  <small>{contact.time}</small>
                </div>
                <p>{contact.text}</p>
                <small>
                  <span class:list={['crm-status', { pending: index === 0 }]}>
                    {contact.status}
                  </span>{' '}
                  <Icon name="whatsapp" size={10} /> Casa Nórdica
                </small>
              </div>
            </div>
          ))}
        </aside>
        <div class="crm-chat">
          <div class="crm-chat-header">
            <b class="crm-avatar">JL</b>
            <div>
              <strong>Julián López</strong>
              <small>
                <Icon name="whatsapp" size={11} /> Casa Nórdica · Agente
                principal
              </small>
            </div>
            <span class="crm-bot">● Esperando al equipo</span>
          </div>
          <div class="crm-messages">
            <span class="crm-day">Hoy</span>
            <div class="crm-bubble">
              ¡Hola! ¿Tienen la silla Nórdica en negro?<small>14:30</small>
            </div>
            <div class="crm-bubble sent">
              ¡Hola, Julián! Sí, tenemos stock en negro. Sale $85.000 y hacemos
              envíos a todo el país.<small>IA · 14:30 ✓✓</small>
            </div>
            <div class="crm-bubble">
              Buenísimo. ¿Me armás un presupuesto por 12 para mi oficina?
              <small>14:32</small>
            </div>
            <span class="crm-event">Etiqueta agregada: Venta mayorista</span>
            <div class="crm-bubble sent">
              ¡Claro! Le paso tu consulta al equipo para que te prepare una
              propuesta por cantidad.<small>IA · 14:32 ✓✓</small>
            </div>
            <span class="crm-event">
              <Icon name="people" size={12} /> Derivada al equipo · contexto
              incluido
            </span>
          </div>
          <div class="crm-compose">
            <Icon name="shield" size={14} />
            <span>Tomá la conversación para continuar con Julián.</span>
            <b>Tomar</b>
          </div>
        </div>
        <aside class="crm-details" aria-label="Ficha del cliente de ejemplo">
          <strong>Info del contacto</strong>
          <div class="crm-detail-card">
            <b class="crm-avatar">JL</b>
            <strong>Julián López</strong>
            <small>julian@ejemplo.com</small>
          </div>
          <div class="crm-detail-card">
            <small class="crm-detail-label">
              <Icon name="atom" size={13} /> RESUMEN DE LA CONVERSACIÓN
            </small>
            <p>
              Consulta por 12 sillas Nórdica negras para su oficina. Espera una
              cotización del equipo.
            </p>
          </div>
          <div class="crm-detail-card">
            <small class="crm-detail-label">
              <Icon name="workflow" size={13} /> ETAPA DEL PIPELINE
            </small>
            <span class="crm-stage">● Presupuesto</span>
          </div>
          <div class="crm-detail-card">
            <small class="crm-detail-label">ETIQUETAS</small>
            <span class="crm-tag">Venta mayorista</span>
          </div>
          <div class="crm-detail-card">
            <small class="crm-detail-label">CAMPOS PERSONALIZADOS</small>
            <p>
              Producto <strong>Silla Nórdica</strong>
            </p>
            <p>
              Cantidad <strong>12 unidades</strong>
            </p>
          </div>
        </aside>
      </div>
      <div
        id={idPrefix + "-pipeline-panel"}
        role="tabpanel"
        aria-labelledby={idPrefix + "-pipeline-tab"}
        class="crm-board"
        hidden
      >
        <div class="crm-board-heading">
          <h5>Pipeline de ventas</h5>
          <span>Casa Nórdica · 4 oportunidades</span>
        </div>
        <div class="crm-columns">
          {stages.map((stage) => (
            <div class="crm-column">
              <h6>
                {stage.title} <span>{stage.names.length}</span>
              </h6>
              {stage.names.map((name) => (
                <article>
                  <small>WHATSAPP</small>
                  <strong>{name}</strong>
                  <p>{stage.text}</p>
                  <span class="crm-tag">
                    {name === 'Julián López'
                      ? 'Venta mayorista'
                      : 'Casa Nórdica'}
                  </span>
                </article>
              ))}
            </div>
          ))}
        </div>
        <p class="crm-board-note">
          Cada oportunidad conserva su conversación y la información del
          contacto.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-crm-preview]').forEach((preview) => {
    const tabs = Array.from(preview.querySelectorAll<HTMLButtonElement>('[data-product-tab]'));
    const activate = (tab: HTMLButtonElement) => {
      tabs.forEach((button) => {
        const selected = button === tab;
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
        const panel = preview.querySelector<HTMLElement>('#' + button.getAttribute('aria-controls'));
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        let next: number | undefined;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        if (next !== undefined) { event.preventDefault(); activate(tabs[next]); tabs[next].focus(); }
      });
    });
  });
</script>

<style>
  .crm-preview { --preview-warning-bg: #fbf3e2; --preview-warning-ink: #7c511a; }
  .crm-preview :is(h4, h5, h6, p) { margin: 0; }
  .crm-preview button { cursor: pointer; }
  .crm-preview [hidden] { display: none !important; }
  .crm-wordmark { display: block; padding: 0 10px 20px; font-size: 24px; font-weight: 600; letter-spacing: -.06em; color: var(--accent-ink); }

  .crm-preview {
    scroll-margin-top: 6rem;
    margin-top: 36px;
    min-width: 0;
  }
  .preview-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }
  .preview-intro h4 {
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }
  .preview-intro p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }
  .preview-intro > span {
    flex-shrink: 0;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .crm-shell {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: 10px;
    padding: 12px;
    background:
      radial-gradient(ellipse at top left, var(--accent-tint), transparent 55%),
      var(--accent-tint);
    border: 1px solid var(--line);
    border-radius: 24px;
    font-size: 12px;
    line-height: 1.5;
  }
  .crm-sidebar,
  .crm-conversations,
  .crm-chat,
  .crm-details {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    min-width: 0;
  }
  .crm-sidebar {
    padding: 20px 10px 12px;
    display: flex;
    flex-direction: column;
  }
  .crm-sidebar > img {
    margin: 0 10px 24px;
  }
  .crm-business,
  .crm-user {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 6px;
  }
  .crm-business {
    background: var(--accent-tint);
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .crm-business strong,
  .crm-user strong {
    font-size: 11px;
  }
  .crm-avatar {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-size: 11px;
  }
  .crm-business .crm-avatar {
    border-radius: 9px;
  }
  .crm-business small,
  .crm-user small {
    display: block;
    color: var(--muted);
    font-size: 9px;
  }
  .crm-menu-item,
  .crm-tabs button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 8px;
    color: var(--muted);
    font-size: 11px;
  }
  .crm-tabs button {
    width: 100%;
    min-height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    text-align: left;
  }
  .crm-tabs button[aria-selected='true'] {
    color: var(--accent-ink);
    background: var(--accent-tint);
    font-weight: 750;
  }
  .crm-tabs button:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }
  .crm-menu-label {
    margin: 20px 8px 5px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  .crm-user {
    margin-top: auto;
    padding-top: 28px;
  }
  .crm-workspace {
    min-width: 0;
  }
  .crm-topbar {
    min-height: 55px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 6px 10px;
  }
  .crm-topbar small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  .crm-topbar strong {
    font: 600 18px var(--font-display);
  }
  .crm-support {
    border-radius: 20px;
    padding: 6px 10px;
    background: var(--preview-warning-bg);
    color: var(--preview-warning-ink);
    font-size: 10px;
  }
  .crm-inbox {
    display: grid;
    grid-template-columns: minmax(160px, 0.85fr) minmax(230px, 1.5fr) minmax(
        165px,
        0.8fr
      );
    gap: 10px;
    min-height: 505px;
  }
  .crm-automation {
    background: var(--accent-tint);
    color: var(--accent-ink);
    padding: 12px;
    border-radius: 16px 16px 0 0;
    font-size: 10px;
  }
  .crm-automation i {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    margin-right: 4px;
  }
  .crm-list-heading {
    display: flex;
    justify-content: space-between;
    padding: 14px 12px 8px;
  }
  .crm-list-heading span {
    color: var(--muted);
  }
  .crm-filters {
    display: flex;
    gap: 5px;
    padding: 0 10px 12px;
    border-bottom: 1px solid var(--line);
  }
  .crm-filters span {
    padding: 3px 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--muted);
    font-size: 9px;
  }
  .crm-conversation {
    display: flex;
    gap: 8px;
    padding: 18px 10px;
  }
  .crm-conversation.selected {
    background: var(--accent-tint);
  }
  .crm-conversation > div {
    min-width: 0;
    flex: 1;
  }
  .crm-contact-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px;
  }
  .crm-contact-line strong {
    font-size: 10px;
  }
  .crm-contact-line small {
    font-size: 8px;
    color: var(--muted);
  }
  .crm-conversation p {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font-size: 10px;
    margin-block: 4px;
  }
  .crm-conversation small {
    font-size: 8px;
    color: var(--muted);
  }
  .crm-conversation :global(svg),
  .crm-chat-header :global(svg),
  .crm-event :global(svg),
  .crm-detail-label :global(svg) {
    display: inline-block;
    vertical-align: middle;
  }
  .crm-status {
    background: var(--accent-tint);
    border-radius: 8px;
    padding: 2px 5px;
  }
  .crm-status.pending {
    background: var(--preview-warning-bg);
    color: var(--preview-warning-ink);
  }
  .crm-chat {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .crm-chat-header {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    padding: 12px;
    border-bottom: 1px solid var(--line);
  }
  .crm-chat-header strong {
    font-size: 11px;
  }
  .crm-chat-header small {
    display: block;
    font-size: 9px;
    color: var(--muted);
  }
  .crm-bot {
    margin-left: auto;
    color: var(--accent-ink);
    font-size: 9px;
  }
  .crm-messages {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 13px;
    padding: 18px 12px;
    flex: 1;
    background: linear-gradient(140deg, var(--bg), var(--accent-tint));
  }
  .crm-day,
  .crm-event {
    align-self: center;
    color: var(--muted);
    font-size: 9px;
    text-align: center;
  }
  .crm-day {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 3px 10px;
  }
  .crm-bubble {
    max-width: 92%;
    padding: 10px 12px;
    border-radius: 14px 14px 14px 3px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-size: 11px;
  }
  .crm-bubble small {
    display: block;
    text-align: right;
    margin-top: 5px;
    font-size: 8px;
    opacity: 0.75;
  }
  .crm-bubble.sent {
    align-self: end;
    border-radius: 14px 14px 3px 14px;
    border-color: transparent;
    background: var(--accent);
    color: var(--bg);
  }
  .crm-compose {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 9px;
  }
  .crm-compose b {
    margin-left: auto;
    border-radius: 20px;
    padding: 5px 10px;
    background: var(--accent);
    color: var(--bg);
  }
  .crm-details {
    padding: 14px 10px;
    background: linear-gradient(var(--bg), var(--accent-tint));
  }
  .crm-details > strong {
    font-size: 11px;
  }
  .crm-detail-card {
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 12px;
    margin-top: 10px;
    border-radius: 14px;
  }
  .crm-detail-card > .crm-avatar {
    display: grid;
    margin-bottom: 7px;
  }
  .crm-detail-card > strong,
  .crm-detail-card > small {
    display: block;
    overflow-wrap: anywhere;
  }
  .crm-detail-card > small {
    color: var(--muted);
    font-size: 9px;
  }
  .crm-detail-label {
    font-size: 8px !important;
    font-weight: 750;
    margin-bottom: 8px;
  }
  .crm-detail-card p {
    color: var(--muted);
    font-size: 10px;
  }
  .crm-detail-card p strong {
    display: block;
    color: var(--ink);
  }
  .crm-stage {
    font-size: 10px;
  }
  .crm-tag {
    display: inline-block;
    background: var(--accent-tint);
    color: var(--accent-ink);
    border-radius: 10px;
    padding: 3px 7px;
    font-size: 9px;
  }
  .crm-board {
    padding: 24px;
    min-height: 505px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .crm-board-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 24px;
  }
  .crm-board h5 {
    font-size: 22px;
  }
  .crm-board-heading > span {
    color: var(--muted);
    font-size: 11px;
  }
  .crm-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .crm-column {
    background: var(--accent-tint);
    border-radius: 12px;
    padding: 12px;
  }
  .crm-column h6 {
    font: 650 12px var(--font-sans);
    margin-bottom: 16px;
  }
  .crm-column h6 span {
    float: right;
    color: var(--muted);
  }
  .crm-column article {
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    margin-bottom: 10px;
  }
  .crm-column article > small {
    display: block;
    font-size: 8px;
    color: var(--accent-ink);
    margin-bottom: 10px;
  }
  .crm-column article > strong {
    display: block;
    font-size: 13px;
  }
  .crm-column article p {
    font-size: 11px;
    color: var(--muted);
    margin: 8px 0 16px;
  }
  .crm-board-note {
    margin-top: 20px;
    font-size: 11px;
    color: var(--muted);
