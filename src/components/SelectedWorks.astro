---
import { getCollection } from 'astro:content';
import CrmPreview from './CrmPreview.astro';
import RuralPreview from './RuralPreview.astro';
import { selectedWorksConfig as config } from '../config/selected-works';

const allProjects = await getCollection('projects');
const publicProjects = allProjects.filter((project) => !project.data.hidden);

const projects =
  config.selection.mode === 'manual'
    ? config.selection.slugs.map((slug) => {
        const project = allProjects.find((entry) => entry.data.slug === slug);

        if (!project) {
          throw new Error(
            `El proyecto "${slug}" configurado en selected-works.ts no existe.`,
          );
        }

        return project;
      }).filter((project) => !project.data.hidden)
    : publicProjects
        .sort(
          (a, b) =>
            Number(b.data.featured) - Number(a.data.featured) ||
            b.data.year.localeCompare(a.data.year),
        )
        .slice(0, config.selection.limit);

const selectedSlugs = new Set(projects.map((project) => project.data.slug));
const otherProjects = publicProjects
  .filter((project) => !selectedSlugs.has(project.data.slug))
  .sort((a, b) => b.data.year.localeCompare(a.data.year));
---

<section class="section section-alt" id={config.id}>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{config.eyebrow}</p>
      <h2>{config.title}</h2>
      <p class="lede">{config.description}</p>
    </div>

    <div class="case-list">
      {
        projects.map((project) => {
          const images = project.data.visuals.filter((visual) => visual.type === 'image' && visual.src);
          const preview = images.find((visual) => (visual.width ?? 0) > (visual.height ?? 0)) ?? images[0];
          return (
          <article class="case" id={project.data.slug === 'plataforma-multi-rubro-agentes' ? 'plataforma' : undefined}>
            <div>
              <h3>{project.data.title}</h3>
              <p class="case-meta">
                {project.data.category} · {project.data.year} · {project.data.status}
              </p>
              {preview && <a class="case-preview" href={'/proyectos/' + project.data.slug + '/'} aria-label={'Ver caso: ' + project.data.title}>
                <img src={preview.src} alt={preview.alt} width={preview.width} height={preview.height} loading="lazy" decoding="async" />
              </a>}
            </div>
            <div>
              <dl class="case-story">
                <div><dt>Problema</dt><dd>{project.data.problem}</dd></div>
                <div><dt>Solución</dt><dd>{project.data.solution}</dd></div>
              </dl>
              {project.data.slug === 'hanexa-puntos' && <a class="points-demo-link" href={project.data.links.demo} target="_blank" rel="noopener noreferrer">Probar demo <span aria-hidden="true">↗</span><span class="link-note"> · abre otra pestaña</span></a>}
              {project.data.role && <p class="case-role"><strong>Mi aporte</strong> {project.data.role}</p>}
              {project.data.stack.length > 0 && <ul class="tags">
                {project.data.stack
                  .slice(0, config.stackLimit)
                  .map((technology) => <li>{technology}</li>)}
              </ul>}
              <a
                class="project-case-link"
                href={`/proyectos/${project.data.slug}/`}
              >
                <span>{config.ctaLabel}</span>
                <i aria-hidden="true">→</i>
              </a>
            </div>
            {project.data.slug === 'hanexa-crm' && <div class="case-visual"><CrmPreview idPrefix="work-crm" /></div>}
            {project.data.slug === 'hanexa-rural' && <div class="case-visual"><RuralPreview idPrefix="work-rural" /></div>}
          </article>
          );
        })
      }
    </div>
    {otherProjects.length > 0 && (
      <div class="other-work">
        <h3>Otros trabajos y exploraciones</h3>
        <p>Automatizaciones, desarrollo full-stack y sitios que forman parte de mi recorrido.</p>
        <ul>
          {otherProjects.map((project) => (
            <li>
              <a href={'/proyectos/' + project.data.slug + '/'}>
                <span>{project.data.title}<small>{project.data.category} · {project.data.year}</small></span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .case-visual { grid-column: 1 / -1; min-width: 0; }
  .points-demo-link { display: inline-block; margin: 0 0 1.5rem; color: var(--accent-ink); text-underline-offset: .3em; }
  .link-note { color: var(--muted); font-size: .75rem; }

  .case-preview { display: block; margin-top: 1.5rem; border: 1px solid var(--line-strong); background: var(--bg); }
  .case-preview img { width: 100%; height: 15rem; padding: .75rem; object-fit: contain; }
  .case-role { font-size: .9rem; margin: 0 0 1.5rem; }
  .case-role strong { display: block; margin-bottom: .35rem; color: var(--muted); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }
  .other-work { margin-top: 3rem; }
  .other-work h3 { margin-bottom: .7rem; }
  .other-work > p { color: var(--muted); }
  .other-work ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; list-style: none; margin: 1.5rem 0 0; padding: 0; }
  .other-work a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; padding-block: 1.1rem; border-top: 1px solid var(--line-strong); text-decoration: none; }
  .other-work a:hover, .other-work a:focus-visible { color: var(--accent); }
  .other-work small { display: block; margin-top: .25rem; color: var(--muted); font-size: .8rem; }
  @media (max-width: 720px) { .other-work ul { grid-template-columns: 1fr; } }
  .case-story { display: grid; gap: 1rem; margin: 0 0 1.5rem; }
  .case-story dt { color: var(--muted); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .35rem; }
  .case-story dd { margin: 0; color: var(--ink-soft); }
  .project-case-link {
    --case-text: #123458;
    --case-line: #bdc9d9;
    --case-accent: #1f518f;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.35rem;
    padding: 0.35rem 0 0.67rem;
    color: var(--case-text);
    font-size: 1.148rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    text-decoration: none;
    transition: color 0.22s ease;
  }

  .project-case-link::before,
  .project-case-link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.4px;
    content: '';
  }

  .project-case-link::before {
    background: var(--case-line);
  }

  .project-case-link::after {
    background: var(--case-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.28s ease;
  }

  .project-case-link i {
    font-size: 1.4rem;
    font-style: normal;
    line-height: 1;
    transition: transform 0.22s ease;
  }

  .project-case-link:hover,
  .project-case-link:focus-visible {
    color: var(--case-accent);
  }

  .project-case-link:hover::after,
  .project-case-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .project-case-link:hover i,
  .project-case-link:focus-visible i {
    transform: translateX(5.6px);
  }

  @media (prefers-color-scheme: dark) {
    .project-case-link {
      --case-text: #a5c9eb;
      --case-line: #263548;
      --case-accent: #70ace1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-case-link,
    .project-case-link::after,
    .project-case-link i {
      transition: none;
    }
  }
</style>
