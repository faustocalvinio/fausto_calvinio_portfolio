<home-scroll-effects aria-hidden="true"></home-scroll-effects>

<script>
  class HomeScrollEffectsElement extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const main = this.closest('main');
      if (!main) return;
      const sections = Array.from(main.querySelectorAll<HTMLElement>(':scope > section'));
      const active = new Set<HTMLElement>();
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;

      const update = () => {
        frame = 0;
        if (document.hidden || reducedMotion.matches) return;
        // Read geometry together before writing transforms, avoiding layout thrashing.
        const shifts = Array.from(active, (section) => {
          const rect = section.getBoundingClientRect();
          const progress = (innerHeight / 2 - rect.top - rect.height / 2) / ((innerHeight + rect.height) / 2);
          return { section, shift: Math.max(-24, Math.min(24, progress * 24)) };
        });
        shifts.forEach(({ section, shift }) => section.style.setProperty('--halo-shift', `${shift.toFixed(2)}px`));
      };
      const schedule = () => {
        if (!frame && !document.hidden && !reducedMotion.matches) frame = requestAnimationFrame(update);
      };
      const syncMotion = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        if (reducedMotion.matches) {
          sections.forEach((section) => section.style.removeProperty('--halo-shift'));
        } else {
          schedule();
        }
      };
      const intersectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) active.add(entry.target as HTMLElement);
          else active.delete(entry.target as HTMLElement);
        });
        schedule();
      });
      sections.forEach((section) => intersectionObserver.observe(section));
      const resizeObserver = new ResizeObserver(schedule);
      resizeObserver.observe(main);
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      reducedMotion.addEventListener('change', syncMotion);
      document.addEventListener('visibilitychange', syncMotion);

      this.cleanup = () => {
        cancelAnimationFrame(frame);
        intersectionObserver.disconnect();
        resizeObserver.disconnect();
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', schedule);
        reducedMotion.removeEventListener('change', syncMotion);
        document.removeEventListener('visibilitychange', syncMotion);
        sections.forEach((section) => section.style.removeProperty('--halo-shift'));
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get('home-scroll-effects')) {
    customElements.define('home-scroll-effects', HomeScrollEffectsElement);
  }
</script>

<style is:global>
  home-scroll-effects { display: none; }
  .home-main {
    --spectrum-a: color-mix(in srgb, #3d8fd1 24%, transparent);
    --spectrum-b: color-mix(in srgb, #7367c9 18%, transparent);
    --halo-opacity: .38;
  }
  .home-main > section:not(.hero) {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .home-main > section:not(.hero)::before {
    position: absolute;
    z-index: -1;
    inset: -28px;
    content: '';
    pointer-events: none;
    background:
      radial-gradient(ellipse 65% 420px at 95% 35%, var(--spectrum-a), transparent 78%),
      radial-gradient(ellipse 55% 360px at 10% 70%, var(--spectrum-b), transparent 78%);
    opacity: var(--halo-opacity);
    transform: translate3d(0, var(--halo-shift, 0px), 0);
  }
  .home-main > section:nth-of-type(2n):not(.hero)::before {
    background:
      radial-gradient(ellipse 65% 420px at 0% 40%, var(--spectrum-a), transparent 78%),
      radial-gradient(ellipse 55% 360px at 90% 65%, var(--spectrum-b), transparent 78%);
  }
  @media (prefers-color-scheme: dark) {
    .home-main {
      --spectrum-a: color-mix(in srgb, #2d7fbf 28%, transparent);
      --spectrum-b: color-mix(in srgb, #735ad0 22%, transparent);
      --halo-opacity: .46;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-main > section:not(.hero)::before { transform: none; }
  }
</style>
