---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import {
  createBreadcrumbSchema,
  createItemListSchema,
} from '../lib/seo';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  articles: CollectionEntry<'articles'>[];
  currentPage: number;
  totalPages: number;
  totalArticles: number;
}

const { articles, currentPage, totalPages, totalArticles } = Astro.props;
const groups = [
  {
    id: 'notas-propias',
    title: 'Notas propias',
    description: 'Apuntes, conceptos y ejemplos de mi recorrido de aprendizaje.',
    articles: articles.filter((article) => !article.data.externalUrl),
  },
  {
    id: 'lecturas-externas',
    title: 'Lecturas externas',
    description: 'Referencias de otras personas que guardé para aprender. Cada enlace lleva a su fuente original.',
    articles: articles.filter((article) => Boolean(article.data.externalUrl)),
  },
].filter((group) => group.articles.length > 0);
const toPreview = (body: string | undefined, fallback: string) => {
  if (!body) return fallback;
  const text = body
    .replace(/```[\s\S]*?```/g, '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^[#>\-*+]+\s*/gm, '')
    .replace(/[*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > 230 ? `${text.slice(0, 230).trimEnd()}…` : text || fallback;
};
const firstArticle =
  (currentPage - 1) * siteConfig.content.notesPerPage + 1;
const lastArticle = firstArticle + articles.length - 1;
const pageHref = (page: number) =>
  page === 1 ? '/notas/' : `/notas/pagina/${page}/`;
const pageTitle =
  currentPage === 1 ? 'Notas' : `Notas — Página ${currentPage}`;
const description =
  currentPage === 1
    ? 'Notas sobre sistemas multiagente, automatización, integraciones e ingeniería de software.'
    : `Página ${currentPage} del archivo de notas sobre ingeniería de software, automatización y agentes de IA.`;
const structuredData = [
  createItemListSchema(
    articles.map((article) => ({
      name: article.data.title,
      url: article.data.externalUrl ?? `/notas/${article.data.slug}/`,
    })),
  ),
  createBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Notas', url: '/notas/' },
    ...(currentPage > 1
      ? [{ name: `Página ${currentPage}`, url: pageHref(currentPage) }]
      : []),
  ]),
];
---

<Layout
  title={pageTitle}
  description={description}
  pageSchemaType="CollectionPage"
  prev={currentPage > 1 ? pageHref(currentPage - 1) : undefined}
  next={currentPage < totalPages ? pageHref(currentPage + 1) : undefined}
  structuredData={structuredData}
>
  <Header />
  <main>
    <header class="notes-hero">
      <div class="container">
        <a class="back" href="/">← Volver al inicio</a>
        <p class="eyebrow">Notas</p>
        <h1>Aprendizajes en público</h1>
        <p class="lede">Apuntes propios sobre desarrollo y una selección de lecturas de otras personas, con sus fuentes identificadas.</p>
      </div>
    </header>

    <section class="section">
      <div class="container notes-index">
        <p class="notes-count">{totalArticles} entradas publicadas · mostrando {firstArticle}–{lastArticle}</p>
        {groups.map((group) => (
          <section class="notes-group" aria-labelledby={group.id}>
            <h2 id={group.id}>{group.title}</h2>
            <p class="group-description">{group.description}</p>
            <div class="article-list notes-list">
          {group.articles.map((article) => (
            <a class="article-row" href={article.data.externalUrl ?? `/notas/${article.data.slug}/`} target={article.data.externalUrl ? '_blank' : undefined} rel={article.data.externalUrl ? 'noreferrer' : undefined}>
              <span class="article-date">{article.data.publishedAt}</span>
              <div class="note-summary">
                <h3>{article.data.title}</h3>
                <p>{article.data.excerpt}</p>
                {!article.data.externalUrl && <p class="note-preview"><span aria-hidden="true">Vista previa · </span>{toPreview(article.body, article.data.excerpt)}</p>}
                {article.data.externalUrl && <span class="source-label">Fuente: {new URL(article.data.externalUrl).hostname.replace(/^www\./, '')} ↗</span>}
                <ul class="tags">{article.data.tags.map((tag) => <li>{tag}</li>)}</ul>
              </div>
              <span class="case-link" aria-hidden="true">{article.data.externalUrl ? '↗' : '→'}</span>
            </a>
          ))}
            </div>
          </section>
        ))}

        {totalPages > 1 && <nav class="pagination" aria-label="Paginación de notas">
          {currentPage > 1 && <a class="pagination-link" href={pageHref(currentPage - 1)}>← Anterior</a>}
          <div class="pagination-pages">
            {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => page === currentPage
              ? <span class="pagination-current" aria-current="page">{page}</span>
              : <a class="pagination-page" href={pageHref(page)}>{page}</a>)}
          </div>
          {currentPage < totalPages && <a class="pagination-link pagination-next" href={pageHref(currentPage + 1)}>Siguiente →</a>}
        </nav>}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .notes-group + .notes-group { margin-top: 4rem; }
  .notes-group > h2 { margin: 0 0 .8rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .group-description { max-width: 62ch; margin: 0 0 1.5rem; color: var(--muted); }
  .note-summary h3 { margin: 0; font: 400 clamp(1.35rem, 1.1rem + .7vw, 1.75rem)/1.15 var(--font-display); letter-spacing: -.02em; }
  .article-row:hover h3, .article-row:focus-visible h3 { color: var(--accent); }
  .source-label { display: block; margin-block: .7rem; color: var(--accent-ink); font-size: .8rem; }
</style>
