---
import { seoConfig } from '../config/seo';
import type { SeoImage, SeoProps, StructuredData } from '../lib/seo';
import { seoIds, toAbsoluteUrl } from '../lib/seo';

const {
  title,
  titleTemplate = true,
  description = seoConfig.defaults.description,
  canonical,
  image,
  type = 'website',
  pageSchemaType = 'WebPage',
  noindex = false,
  nofollow = false,
  publishedTime,
  modifiedTime,
  tags = [],
  prev,
  next,
  mainEntityId,
  structuredData = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL(seoConfig.site.url);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl);
canonicalUrl.search = '';
canonicalUrl.hash = '';

const pageTitle = title
  ? titleTemplate
    ? seoConfig.defaults.titleTemplate.replace('%s', title)
    : title
  : seoConfig.defaults.title;

const resolvedImage: Required<SeoImage> = {
  src: toAbsoluteUrl(image?.src ?? seoConfig.defaults.image.src, siteUrl.href),
  alt: image?.alt ?? seoConfig.defaults.image.alt,
  width: image?.width ?? seoConfig.defaults.image.width,
  height: image?.height ?? seoConfig.defaults.image.height,
  type: image?.type ?? seoConfig.defaults.image.type,
};

const robots = noindex
  ? `noindex, ${nofollow ? 'nofollow' : 'follow'}`
  : `index, ${nofollow ? 'nofollow' : 'follow'}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`;

const socialUrls = Object.values(seoConfig.social).map(({ url }) => url);
const customStructuredData = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];

const baseStructuredData: StructuredData[] = [
  {
    '@type': 'Person',
    '@id': seoIds.person,
    name: seoConfig.author.name,
    givenName: seoConfig.author.givenName,
    familyName: seoConfig.author.familyName,
    jobTitle: seoConfig.author.jobTitle,
    description: seoConfig.site.description,
    url: seoConfig.site.url,
    image: toAbsoluteUrl(seoConfig.author.profileImage),
    email: seoConfig.author.email,
    address: {
      '@type': 'PostalAddress',
      addressCountry: {
        '@type': 'Country',
        name: seoConfig.author.countryName,
        identifier: seoConfig.author.countryCode,
      },
    },
    sameAs: socialUrls,
    knowsAbout: seoConfig.topics,
  },
  {
    '@type': 'WebSite',
    '@id': seoIds.website,
    url: seoConfig.site.url,
    name: seoConfig.site.name,
    description: seoConfig.site.description,
    inLanguage: seoConfig.site.languageTag,
    author: { '@id': seoIds.person },
    publisher: { '@id': seoIds.person },
  },
  {
    '@type': pageSchemaType,
    '@id': `${canonicalUrl.href}#webpage`,
    url: canonicalUrl.href,
    name: pageTitle,
    description,
    inLanguage: seoConfig.site.languageTag,
    isPartOf: { '@id': seoIds.website },
    about: { '@id': seoIds.person },
    ...((mainEntityId || pageSchemaType === 'ProfilePage') && {
      mainEntity: {
        '@id': mainEntityId ?? seoIds.person,
      },
    }),
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: resolvedImage.src,
      contentUrl: resolvedImage.src,
      width: resolvedImage.width,
      height: resolvedImage.height,
      caption: resolvedImage.alt,
    },
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...baseStructuredData, ...customStructuredData],
}).replace(/</g, '\\u003c');
---

<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="author" content={seoConfig.author.name} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang={seoConfig.site.languageTag} href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
{prev && <link rel="prev" href={new URL(prev, siteUrl)} />}
{next && <link rel="next" href={new URL(next, siteUrl)} />}
{socialUrls.map((url) => <link rel="me" href={url} />)}

<meta property="og:site_name" content={seoConfig.site.name} />
<meta property="og:locale" content={seoConfig.site.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={resolvedImage.src} />
<meta property="og:image:secure_url" content={resolvedImage.src} />
<meta property="og:image:type" content={resolvedImage.type} />
<meta property="og:image:width" content={resolvedImage.width} />
<meta property="og:image:height" content={resolvedImage.height} />
<meta property="og:image:alt" content={resolvedImage.alt} />
{type === 'profile' && <meta property="profile:first_name" content={seoConfig.author.givenName} />}
{type === 'profile' && <meta property="profile:last_name" content={seoConfig.author.familyName} />}
{type === 'article' && <meta property="article:author" content={seoConfig.site.url} />}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage.src} />
<meta name="twitter:image:alt" content={resolvedImage.alt} />

<title>{pageTitle}</title>
<script type="application/ld+json" set:html={jsonLd}></script>
