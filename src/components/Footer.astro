---
import { siteConfig } from '../config/site';
import { seoConfig } from '../config/seo';

const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > siteConfig.footer.startYear
    ? `${siteConfig.footer.startYear}–${currentYear}`
    : String(siteConfig.footer.startYear);
const emailHref = `mailto:${seoConfig.author.email}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity">
        <a class="brand footer-brand" href="/" aria-label={`${seoConfig.site.name}, inicio`}>
          <span class="brand-mark"></span>
          <span class="brand-name">{seoConfig.site.name}</span>
        </a>
        <p class="footer-specialty">{siteConfig.footer.specialty}</p>
        <p class="footer-tag">{siteConfig.footer.tagline}</p>
      </div>

      <nav class="footer-column" aria-label="Navegación del pie de página">
        <p class="footer-label">Explorar</p>
        <ul class="footer-nav">
          {
            siteConfig.navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))
          }
        </ul>
      </nav>

      <address class="footer-column footer-contact">
        <p class="footer-label">Contacto</p>
        <a class="footer-email" href={emailHref}>
          <span>{seoConfig.author.email}</span>
          <i aria-hidden="true">↗</i>
        </a>
        <div class="footer-socials" role="group" aria-label="Redes sociales">
          {
            Object.values(seoConfig.social).map((item) => (
              <a href={item.url} target="_blank" rel="me noreferrer">
                {item.label}<span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </address>
    </div>

    <div class="footer-bottom">
      <p class="footer-availability">
        <span aria-hidden="true"></span>
        {siteConfig.footer.availability}
      </p>
      <p>{siteConfig.footer.location}</p>
      <div class="footer-legal">
        <span>© {copyrightYears}</span>
        <a href={siteConfig.contact.cvPath} target="_blank" rel="noreferrer">
          CV <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent-tint) 54%, transparent),
        transparent 48%
      ),
      var(--bg);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(9rem, 0.65fr) minmax(17rem, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(3.5rem, 7vw, 5.75rem);
  }

  .footer-identity {
    max-width: 31rem;
  }

  .footer-brand {
    width: fit-content;
  }

  .footer-specialty {
    max-width: 19ch;
    margin: 1.6rem 0 0.7rem;
    color: var(--ink);
    font: 400 clamp(1.55rem, 1.28rem + 0.9vw, 2.05rem)/1.12 var(--font-display);
    letter-spacing: -0.02em;
  }

  .footer-tag {
    max-width: 34ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.35rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer-label::after {
    width: 2.25rem;
    height: 1px;
    background: var(--line-strong);
    content: '';
  }

  .footer-nav {
    display: grid;
    gap: 0.62rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav a,
  .footer-socials a,
  .footer-legal a {
    color: var(--ink-soft);
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-socials a:hover,
  .footer-socials a:focus-visible,
  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .footer-contact {
    margin: 0;
    font-style: normal;
  }

  .footer-email {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 0.82rem;
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-email::before,
  .footer-email::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: '';
  }

  .footer-email::before {
    background: var(--line-strong);
  }

  .footer-email::after {
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }

  .footer-email span {
    overflow-wrap: anywhere;
  }

  .footer-email i {
    flex: 0 0 auto;
    font-size: 1.15rem;
    font-style: normal;
    transition: transform 0.2s ease;
  }

  .footer-email:hover::after,
  .footer-email:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .footer-email:hover i,
  .footer-email:focus-visible i {
    transform: translate(0.18rem, -0.18rem);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    margin-top: 1.15rem;
    font-size: 0.82rem;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
  }

  .footer-socials a span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .footer-bottom {
    display: grid;
    grid-template-columns: 1.1fr 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.76rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .footer-availability > span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.22rem var(--accent-tint);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }

  .footer-legal a {
    display: inline-flex;
    gap: 0.25rem;
  }

  @media (max-width: 860px) {
    .footer-main {
      grid-template-columns: minmax(0, 1.2fr) minmax(9rem, 0.8fr);
    }

    .footer-contact {
      grid-column: 1 / -1;
      max-width: 32rem;
    }

    .footer-bottom {
      grid-template-columns: 1fr 1fr;
    }

    .footer-legal {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 560px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-block: 3.5rem;
    }

    .footer-contact {
      grid-column: auto;
    }

    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .footer-legal {
      grid-column: auto;
      grid-row: auto;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-nav a,
    .footer-socials a,
    .footer-legal a,
    .footer-email::after,
    .footer-email i {
      transition: none;
    }
  }
</style>
