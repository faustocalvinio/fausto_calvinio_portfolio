---
export interface HeroSystemCluster {
  label: string;
  tools: readonly string[];
}

export interface HeroSystemVisualProps {
  eyebrow?: string;
  statusLabel?: string;
  ariaLabel?: string;
  core?: {
    eyebrow: string;
    title: string;
    subtitle: string;
  };
  clusters?: {
    ai: HeroSystemCluster;
    automation: HeroSystemCluster;
    software: HeroSystemCluster;
    data: HeroSystemCluster;
    web: HeroSystemCluster;
  };
  stages?: readonly string[];
}

const defaults = {
  eyebrow: 'Ecosistema técnico',
  statusLabel: 'Conexiones activas',
  ariaLabel: 'Mapa del ecosistema técnico conectado por una arquitectura central de sistemas',
  core: {
    eyebrow: 'Arquitectura',
    title: 'Sistemas',
    subtitle: 'IA + software',
  },
  clusters: {
    ai: { label: 'IA aplicada', tools: ['CrewAI', 'LLMs', 'RAG', 'MCP', 'Firecrawl', 'OpenCode'] },
    automation: { label: 'Automatización', tools: ['n8n', 'Webhooks', 'REST APIs', 'ETL', 'Google Workspace', 'Notion'] },
    software: { label: 'Software', tools: ['Python', 'TypeScript', 'React', 'Node.js', 'Astro', 'Express', 'JWT'] },
    data: { label: 'Datos', tools: ['PostgreSQL', 'MongoDB', 'Streamlit', 'httpx', 'BeautifulSoup'] },
    web: { label: 'Productos web', tools: ['WordPress', 'WooCommerce', 'Elementor', 'PayPal', 'Tailwind', 'Markdown', 'YoastSEO', 'LiteSpeed'] },
  },
  stages: ['Investigar', 'Conectar', 'Construir', 'Operar'],
} as const;

const {
  eyebrow = defaults.eyebrow,
  statusLabel = defaults.statusLabel,
  ariaLabel = defaults.ariaLabel,
  core = defaults.core,
  clusters = defaults.clusters,
  stages = defaults.stages,
} = Astro.props;

const clusterEntries = Object.entries(clusters) as [keyof typeof clusters, HeroSystemCluster][];
---

<hero-system-visual class="knowledge-map" role="img" aria-label={ariaLabel}>
  <div class="map-meta" aria-hidden="true">
    <span>{eyebrow}</span>
    <span class="map-state"><i></i>{statusLabel}</span>
  </div>

  <div class="map-canvas" data-map-canvas aria-hidden="true">
    <canvas class="connection-canvas" data-connection-canvas></canvas>
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>

    {clusterEntries.map(([id, cluster]) => (
      <section class:list={['knowledge-cluster', `cluster-${id}`]} data-cluster={id}>
        <p><i></i>{cluster.label}</p>
        <div class="cluster-tools">
          {cluster.tools.map((tool) => <span>{tool}</span>)}
        </div>
      </section>
    ))}

    <div class="map-core" data-map-core>
      <span>{core.eyebrow}</span>
      <strong>{core.title}</strong>
      <small>{core.subtitle}</small>
      <i></i>
    </div>
  </div>

  <div class="map-footer" aria-hidden="true">
    {stages.map((stage, index) => (
      <><span>{stage}</span>{index < stages.length - 1 && <i></i>}</>
    ))}
  </div>
</hero-system-visual>

<script>
  class HeroSystemVisualElement extends HTMLElement {
    private frame = 0;
    private visible = true;
    private resizeObserver?: ResizeObserver;
    private intersectionObserver?: IntersectionObserver;
    private darkMode?: MediaQueryList;
    private reducedMotion?: MediaQueryList;
    private redraw = () => {};

    connectedCallback() {
      const stage = this.querySelector<HTMLElement>('[data-map-canvas]');
      const canvas = this.querySelector<HTMLCanvasElement>('[data-connection-canvas]');
      const core = this.querySelector<HTMLElement>('[data-map-core]');
      const clusters = Array.from(this.querySelectorAll<HTMLElement>('[data-cluster]'));
      const context = canvas?.getContext('2d');
      if (!stage || !canvas || !core || !context || clusters.length === 0) return;

      type Point = { x: number; y: number };
      type Connection = { start: Point; end: Point };
      let connections: Connection[] = [];
      let width = 0;
      let height = 0;
      let lineColor = '';
      let accentColor = '';

      const localRect = (element: HTMLElement) => {
        const elementRect = element.getBoundingClientRect();
        const stageRect = stage.getBoundingClientRect();
        return {
          x: elementRect.left - stageRect.left,
          y: elementRect.top - stageRect.top,
          width: elementRect.width,
          height: elementRect.height,
        };
      };

      const center = (rect: ReturnType<typeof localRect>): Point => ({
        x: rect.x + rect.width / 2,
        y: rect.y + rect.height / 2,
      });

      const edgePoint = (rect: ReturnType<typeof localRect>, target: Point): Point => {
        const origin = center(rect);
        const dx = target.x - origin.x;
        const dy = target.y - origin.y;
        const scaleX = dx === 0 ? Number.POSITIVE_INFINITY : (rect.width / 2) / Math.abs(dx);
        const scaleY = dy === 0 ? Number.POSITIVE_INFINITY : (rect.height / 2) / Math.abs(dy);
        const scale = Math.min(scaleX, scaleY);
        return { x: origin.x + dx * scale, y: origin.y + dy * scale };
      };

      const updateGeometry = () => {
        const stageRect = stage.getBoundingClientRect();
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        width = stageRect.width;
        height = stageRect.height;
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

        const styles = getComputedStyle(this);
        lineColor = styles.getPropertyValue('--connection-canvas').trim();
        accentColor = styles.getPropertyValue('--signal-canvas').trim();

        const coreRect = localRect(core);
        const coreCenter = center(coreRect);
        connections = clusters.map((cluster) => {
          const clusterRect = localRect(cluster);
          const clusterCenter = center(clusterRect);
          return {
            start: edgePoint(clusterRect, coreCenter),
            end: edgePoint(coreRect, clusterCenter),
          };
        });
      };

      const drawDot = (point: Point, radius: number, color: string) => {
        context.beginPath();
        context.arc(point.x, point.y, radius, 0, Math.PI * 2);
        context.fillStyle = color;
        context.fill();
      };

      const render = (time = 0) => {
        context.clearRect(0, 0, width, height);
        context.lineWidth = 1.25;
        context.lineCap = 'round';

        connections.forEach((connection, index) => {
          context.beginPath();
          context.moveTo(connection.start.x, connection.start.y);
          context.lineTo(connection.end.x, connection.end.y);
          context.strokeStyle = lineColor;
          context.stroke();

          drawDot(connection.start, 2.4, lineColor);
          drawDot(connection.end, 2.4, lineColor);

          if (!this.reducedMotion?.matches) {
            const progress = ((time / 5200) + index / connections.length) % 1;
            const signal = {
              x: connection.start.x + (connection.end.x - connection.start.x) * progress,
              y: connection.start.y + (connection.end.y - connection.start.y) * progress,
            };
            context.save();
            context.shadowBlur = 12;
            context.shadowColor = accentColor;
            drawDot(signal, 3.1, accentColor);
            context.restore();
          }
        });

        if (this.visible && !this.reducedMotion?.matches) {
          this.frame = requestAnimationFrame(render);
        }
      };

      this.redraw = () => {
        cancelAnimationFrame(this.frame);
        updateGeometry();
        render();
      };

      this.darkMode = window.matchMedia('(prefers-color-scheme: dark)');
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.darkMode.addEventListener('change', this.redraw);
      this.reducedMotion.addEventListener('change', this.redraw);

      this.resizeObserver = new ResizeObserver(this.redraw);
      this.resizeObserver.observe(stage);
      clusters.forEach((cluster) => this.resizeObserver?.observe(cluster));

      this.intersectionObserver = new IntersectionObserver(([entry]) => {
        this.visible = entry?.isIntersecting ?? false;
        this.redraw();
      }, { rootMargin: '120px' });
      this.intersectionObserver.observe(this);
      this.redraw();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.resizeObserver?.disconnect();
      this.intersectionObserver?.disconnect();
      this.darkMode?.removeEventListener('change', this.redraw);
      this.reducedMotion?.removeEventListener('change', this.redraw);
    }
  }

  if (!customElements.get('hero-system-visual')) {
    customElements.define('hero-system-visual', HeroSystemVisualElement);
  }
</script>

<style>
  .knowledge-map {
    --map-bg: color-mix(in srgb, var(--bg) 84%, var(--accent-tint));
    --map-panel: color-mix(in srgb, var(--bg) 90%, transparent);
    --map-line: color-mix(in srgb, var(--line-strong) 80%, transparent);
    --map-line-soft: color-mix(in srgb, var(--line) 68%, transparent);
    --map-glow: color-mix(in srgb, var(--accent) 16%, transparent);
    --connection-canvas: #778ca5;
    --signal-canvas: #1f518f;
    position: relative;
    isolation: isolate;
    display: block;
    min-height: 510px;
    overflow: hidden;
    border: 1px solid var(--map-line);
    background:
      radial-gradient(circle at 50% 49%, var(--map-glow), transparent 31%),
      linear-gradient(var(--map-line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--map-line-soft) 1px, transparent 1px),
      var(--map-bg);
    background-size: auto, 38px 38px, 38px 38px, auto;
    box-shadow:
      0 26px 70px color-mix(in srgb, var(--ink) 9%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--bg) 52%, transparent);
    color: var(--ink);
    transition: border-color .3s ease, box-shadow .3s ease;
  }

  .knowledge-map::after {
    position: absolute;
    z-index: 6;
    inset: 9px;
    border: 1px solid color-mix(in srgb, var(--line) 42%, transparent);
    content: '';
    pointer-events: none;
  }

  .knowledge-map:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow:
      0 30px 82px color-mix(in srgb, var(--ink) 12%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--bg) 52%, transparent);
  }

  .map-meta,
  .map-footer {
    position: relative;
    z-index: 7;
    display: flex;
    align-items: center;
    color: var(--muted);
    font-size: .59rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .map-meta {
    justify-content: space-between;
    min-height: 49px;
    padding-inline: 1.15rem;
    border-bottom: 1px solid var(--map-line);
    background: color-mix(in srgb, var(--map-panel) 78%, transparent);
    backdrop-filter: blur(8px);
  }

  .map-state {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--accent-ink);
  }

  .map-state i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 48%, transparent);
    animation: map-live 2.7s ease-out infinite;
  }

  .map-canvas {
    position: relative;
    z-index: 2;
    min-height: 414px;
  }

  .connection-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .orbit {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .orbit-one {
    width: 58%;
    aspect-ratio: 1;
    animation: orbit-breathe 8s ease-in-out infinite;
  }

  .orbit-two {
    width: 84%;
    aspect-ratio: 1;
    border-style: dashed;
    opacity: .48;
    animation: orbit-breathe 11s 1.8s ease-in-out infinite reverse;
  }

  .knowledge-cluster {
    position: absolute;
    z-index: 4;
    padding: .72rem .8rem;
    border: 1px solid var(--map-line);
    background: color-mix(in srgb, var(--map-panel) 94%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 6%, transparent);
    backdrop-filter: blur(8px);
    transition: border-color .25s ease, background .25s ease, box-shadow .25s ease;
  }

  .knowledge-map:hover .knowledge-cluster {
    border-color: color-mix(in srgb, var(--accent) 37%, var(--map-line));
  }

  .knowledge-cluster:hover {
    border-color: color-mix(in srgb, var(--accent) 70%, var(--map-line));
    background: color-mix(in srgb, var(--map-panel) 88%, var(--accent-tint));
    box-shadow: 0 12px 30px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .knowledge-cluster p {
    display: flex;
    align-items: center;
    gap: .4rem;
    margin: 0 0 .44rem;
    color: var(--accent-ink);
    font-size: .52rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .knowledge-cluster p i {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent);
  }

  .cluster-tools {
    display: flex;
    flex-wrap: wrap;
    gap: .14rem .46rem;
  }

  .cluster-tools span {
    position: relative;
    color: var(--ink-soft);
    font-size: .55rem;
    line-height: 1.45;
    white-space: nowrap;
  }

  .cluster-tools span:not(:first-child)::before {
    position: absolute;
    top: 50%;
    left: -.29rem;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--muted);
    content: '';
  }

  .cluster-ai {
    top: 5%;
    left: 50%;
    width: 58%;
    transform: translateX(-50%);
  }

  .cluster-automation {
    top: 34%;
    left: 3%;
    width: 34%;
  }

  .cluster-software {
    top: 34%;
    right: 3%;
    width: 34%;
  }

  .cluster-data {
    bottom: 5%;
    left: 4%;
    width: 43%;
  }

  .cluster-web {
    right: 4%;
    bottom: 5%;
    width: 43%;
  }

  .map-core {
    position: absolute;
    z-index: 5;
    top: 53%;
    left: 50%;
    display: grid;
    width: 104px;
    min-height: 92px;
    place-content: center;
    border: 1px solid color-mix(in srgb, var(--accent) 58%, var(--map-line));
    background: color-mix(in srgb, var(--map-panel) 95%, var(--accent-tint));
    box-shadow:
      0 0 0 8px color-mix(in srgb, var(--bg) 45%, transparent),
      0 14px 34px color-mix(in srgb, var(--ink) 10%, transparent);
    text-align: center;
    transform: translate(-50%, -50%);
    transition: border-color .3s ease, box-shadow .3s ease;
  }

  .knowledge-map:hover .map-core {
    border-color: var(--accent);
    box-shadow:
      0 0 0 8px color-mix(in srgb, var(--bg) 45%, transparent),
      0 0 34px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .map-core span {
    color: var(--muted);
    font-size: .46rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .map-core strong {
    margin-top: .18rem;
    font: 500 1.05rem/1.1 var(--font-display);
  }

  .map-core small {
    margin-top: .2rem;
    color: var(--muted);
    font-size: .53rem;
  }

  .map-core > i {
    position: absolute;
    top: .55rem;
    right: .55rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .map-footer {
    justify-content: center;
    gap: .5rem;
    min-height: 46px;
    padding-inline: .75rem;
    border-top: 1px solid var(--map-line);
    background: color-mix(in srgb, var(--map-panel) 78%, transparent);
  }

  .map-footer i {
    width: clamp(7px, 2vw, 17px);
    height: 1px;
    background: var(--map-line);
  }

  @keyframes map-live {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 48%, transparent); }
    70%, 100% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 0%, transparent); }
  }

  @keyframes orbit-breathe {
    0%, 100% { opacity: .35; transform: translate(-50%, -50%) scale(.96); }
    50% { opacity: .72; transform: translate(-50%, -50%) scale(1.04); }
  }

  @media (prefers-color-scheme: dark) {
    .knowledge-map {
      --map-bg: color-mix(in srgb, var(--bg) 90%, #132337);
      --map-panel: color-mix(in srgb, var(--bg-alt) 90%, transparent);
      --map-line: color-mix(in srgb, var(--line-strong) 88%, transparent);
      --map-line-soft: color-mix(in srgb, var(--line) 76%, transparent);
      --map-glow: color-mix(in srgb, var(--accent) 13%, transparent);
      --connection-canvas: #71849a;
      --signal-canvas: #70ace1;
      box-shadow:
        0 28px 74px rgba(0, 0, 0, .3),
        inset 0 0 0 1px rgba(255, 255, 255, .018);
    }
  }

  @media (max-width: 560px) {
    .knowledge-map {
      min-height: 488px;
      background-size: auto, 32px 32px, 32px 32px, auto;
    }

    .map-meta {
      min-height: 46px;
      padding-inline: .9rem;
      font-size: .5rem;
    }

    .map-canvas {
      min-height: 399px;
    }

    .knowledge-cluster {
      padding: .52rem .55rem;
    }

    .cluster-ai { width: 68%; }
    .cluster-automation,
    .cluster-software { width: 35%; }
    .cluster-data,
    .cluster-web { width: 44%; }

    .knowledge-cluster p { font-size: .44rem; }
    .cluster-tools { gap: .1rem .39rem; }
    .cluster-tools span { font-size: .48rem; }

    .map-core {
      width: 88px;
      min-height: 80px;
    }

    .map-core strong { font-size: .9rem; }

    .map-footer {
      min-height: 43px;
      gap: .35rem;
      font-size: .44rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knowledge-map,
    .knowledge-cluster,
    .map-core { transition: none; }
    .map-state i,
    .orbit { animation: none; }
  }
</style>
